{
  "name": "solarpolis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A procedural O'Neill cylinder in the browser.",
  "scripts": {
    "dev": "node tools/actors/pack.mjs && vite",
    "build": "node tools/actors/pack.mjs && tsc --noEmit && vite build",
    "build:publish": "node tools/actors/pack.mjs && tsc --noEmit && vite build --mode publish",
    "actors:pack": "node tools/actors/pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/guards/guards.mjs && node --import tsx --test --experimental-test-isolation=none --test-concurrency=1 --test-reporter=./tools/ci/budget-reporter.mjs --test-reporter-destination=stdout \"test/*.test.ts\" \"tools/**/*.test.mjs\"",
    "test:slow": "node --import tsx --test \"test/slow/**/*.slow.test.ts\"",
    "dup": "node tools/duplicate-candidates/find-duplicate-candidates.mjs",
    "repeated": "node tools/repeated-code/find-repeated-code.mjs",
    "shots": "node scripts/shots/shots.mjs"
  },
  "dependencies": {
    "@actors/animal": "https://github.com/ArndRosemeier/Actors/releases/download/v0.6.3/actors-animal-0.6.3.tgz",
    "@actors/core": "https://github.com/ArndRosemeier/Actors/releases/download/v0.6.3/actors-core-0.6.3.tgz",
    "@actors/drone": "https://github.com/ArndRosemeier/Actors/releases/download/v0.6.3/actors-drone-0.6.3.tgz",
    "@actors/generator": "https://github.com/ArndRosemeier/Actors/releases/download/v0.6.3/actors-generator-0.6.3.tgz",
    "@actors/human": "https://github.com/ArndRosemeier/Actors/releases/download/v0.6.3/actors-human-0.6.3.tgz",
    "@actors/three": "https://github.com/ArndRosemeier/Actors/releases/download/v0.6.3/actors-three-0.6.3.tgz",
    "@dimforge/rapier3d-compat": "0.19.3",
    "@futuremagic/core": "file:vendor/assetgenerator/packages/core",
    "@futuremagic/stage": "file:vendor/assetgenerator/packages/stage",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
}
