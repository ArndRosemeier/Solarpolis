{
  "banned": [
    { "id": "Math.random", "pattern": "\\bMath\\.random\\s*\\(", "only": [], "why": "every random number comes from a seed: Rng / deriveSeed (@futuremagic/core)" },
    { "id": "new WebGPURenderer", "pattern": "\\bnew\\s+(WebGPURenderer|WebGLRenderer)\\b", "only": [], "why": "one renderer, made by createRenderer from @futuremagic/stage" },
    { "id": "WebGL fallback", "pattern": "\\bforceWebGL\\b|getContext\\(\\s*['\"]webgl", "only": [], "why": "Solarpolis is WebGPU only, with no WebGL fallback (Arnd, 2026-10-21)" },
    { "id": "camera .project(", "pattern": "\\.project\\(\\s*[\\w.]*cam", "flags": "gi", "only": ["src/render/screen.ts"], "why": "world-to-screen goes through screen.toScreen" },
    { "id": "new Worker", "pattern": "\\bnew\\s+Worker\\s*\\(", "only": ["src/workers/pool.ts"], "why": "workers are created by the one worker pool" },
    { "id": "new Material", "pattern": "\\bnew\\s+\\w*Material\\s*\\(", "only": ["src/render/materials.ts"], "why": "every material is a kind in the registry, so warm-up knows every shader (docs/SHADERS.md)" },
    { "id": "onBeforeCompile", "pattern": "\\bonBeforeCompile\\b", "only": [], "why": "shader variants come from the registry's TSL kinds, not from patched source (docs/SHADERS.md)" },
    { "id": "renderer.compile", "pattern": "\\.compile(Async)?\\s*\\(", "only": [], "why": "compiling is the Stage's job (@futuremagic/stage): warmUp(), warmLater() and add() (docs/SHADERS.md)" },
    { "id": "new Light", "pattern": "\\bnew\\s+(PointLight|SpotLight|DirectionalLight|HemisphereLight|AmbientLight|RectAreaLight)\\s*\\(", "only": ["src/render/lights.ts"], "why": "lights are a fixed pool made before the warm-up: the light count is part of every shader's cache key (docs/SHADERS.md)" },
    { "id": "localStorage", "pattern": "\\blocalStorage\\b", "only": ["src/persist/"], "why": "persistence goes through src/persist" },
    { "id": "indexedDB", "pattern": "\\bindexedDB\\b", "only": ["src/persist/"], "why": "persistence goes through src/persist" },
    { "id": "fetch openrouter", "pattern": "openrouter\\.ai", "flags": "gi", "only": ["src/llm/"], "why": "every LLM call goes through src/llm (model roster, task routing, usage tracking)" },
    { "id": "wall clock", "pattern": "\\bDate\\.now\\s*\\(|\\bnew\\s+Date\\s*\\(", "only": ["src/app/", "src/render/", "src/audio/", "src/persist/", "src/workers/"], "why": "the pure layers are deterministic: time is injected" },
    { "id": "AudioContext", "pattern": "\\bnew\\s+(webkit)?AudioContext\\s*\\(", "only": ["src/audio/"], "why": "one audio engine (src/audio)" },
    { "id": "rapier", "pattern": "@dimforge/rapier", "only": ["src/physics/"], "why": "one physics world (src/physics)" },
    { "id": "performance.memory", "pattern": "\\bperformance\\s*\\.\\s*(memory|measureUserAgentSpecificMemory)\\b", "only": ["src/app/memory.ts"], "why": "memory is read by the one watchdog (src/app/memory.ts)" }
  ],
  "layers": [
    { "from": "src/blueprint", "deny": ["three", "src/render", "src/app", "src/lab", "src/gen", "src/world", "src/sim", "src/physics"], "why": "the blueprint is the root of everything: pure numbers, no three.js, nothing above it" },
    { "from": "src/gen", "deny": ["three", "src/render", "src/app", "src/lab", "src/world", "src/sim", "src/physics"], "why": "the generator is pure data: it runs in workers and headless tests" },
    { "from": "src/world", "deny": ["three", "src/render", "src/app", "src/lab", "src/physics"], "why": "world queries are pure: gameplay, workers and tests use them" },
    { "from": "src/sim", "deny": ["three", "src/render", "src/app", "src/lab", "src/physics"], "why": "the society sim is pure: it runs in a worker and in headless tests" },
    { "from": "src/render", "deny": ["src/app", "src/lab"], "why": "the renderer does not know about the app or the Lab" },
    { "from": "src/persist", "deny": ["three", "src/render", "src/app", "src/lab"], "why": "persistence is a leaf: everything may save and load through it" }
  ],
  "duplication": {
    "roots": {
      "solarpolis": "src",
      "core": "vendor/assetgenerator/packages/core/src",
      "stage": "vendor/assetgenerator/packages/stage/src"
    }
  }
}
